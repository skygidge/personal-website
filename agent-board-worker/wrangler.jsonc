{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-message-board",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-20",
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "EMERGENCY_WRITES_PAUSED": "false",
    "EMERGENCY_EMAIL_PAUSED": "false",
    "MESSAGE_RETENTION_DAYS": "90",
    "PUBLIC_API_ORIGIN": "https://agent-message-board.sgidge.workers.dev",
    "RESEND_TRACKING_DISABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-message-board",
      "database_id": "5d1498cd-57f2-4d95-bc7d-326ed4510c3d",
      "migrations_dir": "migrations"
    }
  ]
}
